# Required dashboard login
DASHBOARD_PASSWORD=change-this-to-a-long-random-password
AUTH_SECRET=replace-with-a-long-random-secret

# Supabase (required for durable queue, history and image storage)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_BUCKET=bct-memes

# Meta Facebook Page publishing (required for auto publishing)
META_PAGE_ID=1389119647626527
META_PAGE_ACCESS_TOKEN=YOUR_PAGE_ACCESS_TOKEN
META_GRAPH_VERSION=v23.0

# Optional AI caption generation (fallback captions work without this)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Image model for AI backgrounds (change if Google retires it)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Cron protection. Use same value in Vercel Cron URL query (?secret=...)
CRON_SECRET=replace-with-another-long-random-secret

# Optional comma-separated RSS sources. Default sources are in lib/trends.ts
TREND_RSS_URLS=
